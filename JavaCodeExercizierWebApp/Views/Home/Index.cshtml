<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Java Editor</title>

    <!-- Monaco via CDN -->
    <script src="https://unpkg.com/monaco-editor@0.54.0/min/vs/loader.js"></script>

    <style>
        body {
          margin: 0;
          display: flex;
          flex-direction: column;
          height: 100vh;
          background: #1e1e1e;
          color: white;
          font-family: sans-serif;
        }
        #editor {
          flex: 1;
          border-top: 1px solid #444;
            height: 70vh;
        }
        #controls {
          padding: 8px;
          background: #333;
          display: flex;
          justify-content: start;
          align-items: center;
        }
        button:hover { background: #005fa3; }
        pre {
          background: #111;
          color: #9f9;
          padding: 8px;
          border-radius: 4px;
          max-height: 150px;
          overflow: auto;
        }

        .javac-error-line {
            background-color: rgba(255, 0, 0, 0.2);
        }

    </style>
</head>
<body>
    <div id="controls">
        <span>Java Editor (Monaco)</span>
    </div>
    <div id="editor"></div>
    <pre id="output" style="height:20vh"></pre>

    <script>
          require.config({ paths: { vs: "https://unpkg.com/monaco-editor@0.54.0/min/vs" } });
          require(["vs/editor/editor.main"], function () {
            const editor = monaco.editor.create(document.getElementById("editor"), {
              value: `class App {
    public static void main(String[] args) {
        System.out.println("Ciao mondo!");
    }
}`,
              language: "java",
              theme: "vs-dark",
              automaticLayout: true,
              fontSize: 14
            });


            const output = document.getElementById("output");

            async function run() {
              const code = editor.getValue();
              output.textContent = "";
              monaco.editor.setModelMarkers(editor.getModel(), "javac", []);
              try {
                const res = await fetch("/run", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    files: { "App.java": code },
                    main: "App"
                  })
                });
                const data = await res.json();
                if (!data.ok && data.phase === "compile") {
                    output.textContent = `[compile error]\n${data.stderr}`;
                    const regex = /:(\d+): error: (.*)/g;
                    let match;
                    const markers = [];
                    while ((match = regex.exec(data.stderr)) !== null) {
                      const line = parseInt(match[1]);
                      const message = match[2].trim();
                      const model = editor.getModel();
                      const endCol = model.getLineMaxColumn(line);
                      markers.push({
                        startLineNumber: line,
                        startColumn: 1,
                        endLineNumber: line,
                        endColumn: endCol,
                        message,
                        severity: monaco.MarkerSeverity.Error,
                      });
                    }
                    monaco.editor.setModelMarkers(editor.getModel(), "javac", markers);
                  } else {
                    output.textContent = data.ok
                      ? (data.stdout || "(nessun output)")
                      : `[${data.phase} error]\n${data.stderr}`;
                  }
              } catch (e) {
                output.textContent = "Errore: " + e.message;
              }
            }

            let t;
            editor.onDidChangeModelContent(() => {
              clearTimeout(t);
              t = setTimeout(run, 600);
            });
          });
    </script>

</body>
</html>
